[node name="VillageSign" type="Area2D" parent="Interactables"]
position = Vector2(706, 640)
script = ExtResource("2_interactable")
lines = PackedStringArray("一块旧村牌钉在牌坊柱上。「名花流村」四个字被人用刀划得稀烂。", "上面用红漆重新写了三个字——", "封门村。")
clue_id = ""
one_shot = false

[node name="C" type="CollisionShape2D" parent="Interactables/VillageSign"]
shape = SubResource("RectangleShape2D_sign")

[node name="BrokenCoffin" type="Area2D" parent="Interactables"]
position = Vector2(462, 862)
script = ExtResource("2_interactable")
lines = PackedStringArray("我爹的棺材。棺盖从里面炸开了，木刺全朝着外面。", "四年，我在这里面躺了四年。", "里面那本金字的书，已经化成了灰。像是任务完成了，就走了。")
clue_id = ""
one_shot = false

[node name="C" type="CollisionShape2D" parent="Interactables/BrokenCoffin"]
shape = SubResource("RectangleShape2D_coffin")

[node name="OldTree" type="Area2D" parent="Interactables"]
position = Vector2(797, 678)
script = ExtResource("2_interactable")
lines = PackedStringArray("村口的老槐树，打我记事起就在。", "树上挂满了红布条。以前求平安才挂，一年也就挂三五条。", "现在，挂红的比挂叶的多。")
clue_id = ""
one_shot = false

[node name="C" type="CollisionShape2D" parent="Interactables/OldTree"]
shape = SubResource("RectangleShape2D_tree_area")

[node name="DryWell" type="Area2D" parent="Interactables"]
position = Vector2(860, 668)
script = ExtResource("2_interactable")
lines = PackedStringArray("井绳还在，桶也还在。", "我往下看了一眼。井是干的，干得发白。", "六月的雨季，井不该是干的。")
clue_id = ""
one_shot = false

[node name="C" type="CollisionShape2D" parent="Interactables/DryWell"]
shape = SubResource("RectangleShape2D_well_area")

